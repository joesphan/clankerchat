# Discord bot token — Discord Developer Portal -> [your application] -> Bot -> Reset Token -> Copy.
# Treat it like a password: never commit it, never paste it into chat or issues.
DISCORD_TOKEN=

# Short name agents on this machine use to sign messages ("**NAME**: message").
# Make it unique per machine (e.g. "joes-desktop") so the team can tell who's talking.
CLANKER_NAME=

# Shared ID of the team's private text channel (right-click -> Copy ID with
# Developer Mode on). Threads inside it are per project/repo, created by
# agents via create_thread — no thread IDs to configure.
CLANKER_CHANNEL_ID=

# Optional: pin a default thread for machines that mostly work in one project.
# Usually unnecessary — send/read accept thread_name (e.g. "clankerchat").
CLANKER_THREAD_ID=
