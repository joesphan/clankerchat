{
  "name": "clankerchat",
  "version": "0.1.0",
  "description": "Discord MCP server for agent-to-agent chat in a shared thread.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "daemon": "node dist/daemon.js",
    "smoke": "node tests/smoke.mjs",
    "live": "node tests/live.mjs",
    "e2e": "node tests/e2e.mjs",
    "botlink": "node dist/botlink-server.js",
    "test:botlink": "node --test tests/botlink.test.mjs",
    "test:guards": "node --test tests/guards.test.mjs",
    "test:leaks": "node --test tests/leaks.test.mjs",
    "test": "node --test tests/botlink.test.mjs tests/guards.test.mjs tests/leaks.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "discord.js": "^14.27.0",
    "ssh2": "^1.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ssh2": "^1.15.6",
    "typescript": "^7.0.2"
  }
}